# =============================================================================
# Root .env — Docker Compose Infrastructure Variables
# =============================================================================
# Copy: cp .env.example .env  then fill values
# This file is read by docker-compose.yml for shared infrastructure config
# =============================================================================

# Database
DB_USER=erp_user
DB_PASSWORD=<CHANGE_THIS>
DB_NAME=erp_db

# Redis
REDIS_PASSWORD=<CHANGE_THIS>

# Yapay zekâ (host'ta native Ollama)
OLLAMA_MODEL=qwen3.5:9b

# Dağıtım modu: cloud | onprem (müşteri cihazı — AI yalnız yerel, Sentry kapalı)
DEPLOYMENT_MODE=cloud
# Chatbot döviz kuru aracı (open.er-api.com, müşteri verisi göndermez)
ALLOW_EXTERNAL_RATES=true
# Ters vekil (nginx) arkasında gerçek istemci IP'si için (1 = tek vekil). Backend doğrudan yayınlıysa boş bırakın:
# aksi halde X-Forwarded-For sahtelenip IP kara listesi/oran sınırı atlatılabilir.
TRUST_PROXY=1
# Kayıt politikası: onprem'de herkese açık kayıt kapalı (true yaparsanız açılır); demo ortamı için
# REGISTRATION_AUTO_APPROVE=true varsayılan şirkete katılımı onaysız kabul eder (müşteri kurulumunda KULLANMAYIN).
# ALLOW_SELF_REGISTRATION=false
# REGISTRATION_AUTO_APPROVE=false
# Hesap kilidi: son başarılı girişten sonra 15 dk'da bu kadar hatalı parola → geçici kilit
# LOGIN_LOCK_MAX=10
# Yedek parolası değişimi / kurtarma olaylarında Helix-Ware'e gidecek bildirim adresi
# (yalnız firma + olay + zaman; anahtar/parola/veri gitmez). Boş = bize bildirim gitmez.
HELIX_BILDIRIM_EPOSTA=

# Docker Hub (for CI/CD image pulling)
DOCKERHUB_USERNAME=yourdockerhubusername
IMAGE_TAG=latest

# Frontend public URL (used during build)
VITE_API_URL=
