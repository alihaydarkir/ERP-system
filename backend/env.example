# Database
DATABASE_URL=postgresql://postgres:secure_password@localhost:5432/erp_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secure_password
DB_NAME=erp_db

# Redis
REDIS_URL=redis://localhost:6379

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Windows RTX 4060 (8GB VRAM): qwen3.5:9b (native tool calling + iyi Türkçe, %100 GPU)
# Diğer: qwen2.5:7b · Düşük VRAM (4GB): qwen2.5:3b
OLLAMA_MODEL=qwen3.5:9b
# Tüm çağrılarda ortak bağlam (değişirse Ollama modeli her istekte yeniden yükler).
# 8192'den küçük olursa 40 aracın şeması kırpılır ve araç seçimi bozulur.
OLLAMA_NUM_CTX=8192

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars_change_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost:5000,localhost:5173
STRICT_ORIGIN_CHECK=false

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# AI
AI_MAX_CONTEXT=2000
AI_REQUEST_TIMEOUT_MS=180000
AI_AUTOMATION_MODE=copilot
# Düşünen modellerde (qwen3.5 vb.) "thinking" aşama bazlı; düşünmeyen modellerde etkisiz.
# Varsayılan ikisi de false — açınca kalite artışı ölçülmedi, yanıt 4-10x yavaşlıyor.
AI_THINK_PLAN=false
AI_THINK_RESPOND=false
AI_PROVIDER=ollama
AI_MODEL=
AI_FALLBACK_MODEL=llama2
RAG_TOP_K=5
RAG_THRESHOLD=0.7

